# ============================================================
# Nexuron Technologies — local / deploy env template
# Copy to .env (or .env.local) and fill real values. Never commit secrets.
# ============================================================

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://nexurontechnologies.com

# MySQL
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# SMTP (Hostinger example)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@example.com
SMTP_PASS=REPLACE_WITH_MAILBOX_PASSWORD
SMTP_FROM=info@example.com
SMTP_FROM_NAME=Nexuron Technologies
CONTACT_NOTIFY_TO=info@example.com

# Cloudflare R2 (media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional Greenvelly API override
# NEXT_PUBLIC_GREENVELLY_API_BASE=
